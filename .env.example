# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Service auth (shared secret with Ideablock backend) ───────────────────────
# Backend passes this in the X-Merkler-Key header on every request
MERKLER_SERVICE_KEY=changeme

# ── timeglue (Bitcoin stamping service) ───────────────────────────────────────
TIMEGLUE_URL=http://localhost:2312

# ── Google Cloud Firestore ────────────────────────────────────────────────────
GCP_PROJECT_ID=ideablock-merkler
# Path to service account key JSON file (relative to repo root)
# Leave blank to use Application Default Credentials (Cloud Run, GKE, etc.)
GCP_FIRESTORE_KEYFILE=ideablock-merkler-secret.json

# ── Cron schedule (UTC) ───────────────────────────────────────────────────────
# Default: 04:30 UTC = 11:30 PM EST
# Override to run at a different time (cron syntax)
MERKLER_CRON=30 4 * * *
